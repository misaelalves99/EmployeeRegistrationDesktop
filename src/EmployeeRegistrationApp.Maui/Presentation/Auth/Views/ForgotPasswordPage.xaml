<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Auth.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Auth.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <Grid x:Name="RootGrid" Padding="32">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="RootGrid" Property="Padding" Value="32" />
                        <Setter TargetName="FormPanel" Property="Padding" Value="28" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="RootGrid" Property="Padding" Value="16" />
                        <Setter TargetName="FormPanel" Property="Padding" Value="20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border
            x:Name="FormPanel"
            MaximumWidthRequest="480"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Padding="28"
            BackgroundColor="{AppThemeBinding Light={StaticResource Color.CardBackground.Light}, Dark={StaticResource Color.CardBackground}}"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource Color.BorderSubtle.Light}, Dark={StaticResource Color.BorderSubtle}}"
            StrokeShape="RoundRectangle 24"
            Shadow="{StaticResource Shadow.Card}">

            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Recuperar acesso"
                        SemanticProperties.HeadingLevel="Level1"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}" />
                    <Label
                        Text="Informe seu e-mail. Nesta versão de demonstração, a solicitação é validada localmente e retorna ao login."
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                </VerticalStackLayout>

                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="{StaticResource Color.DangerSoft}"
                    Stroke="{StaticResource Color.Danger}"
                    StrokeThickness="1"
                    Padding="8"
                    StrokeShape="RoundRectangle 12">
                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="12"
                        TextColor="{StaticResource Color.Danger}" />
                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="E-mail"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                    <Entry
                        Text="{Binding Email}"
                        SemanticProperties.Description="E-mail"
                        Placeholder="seu.email@empresa.com"
                        Keyboard="Email"
                        TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource Color.TextMuted.Light}, Dark={StaticResource Color.TextMuted}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}"
                        HeightRequest="42" />
                </VerticalStackLayout>

                <Button
                    Text="Enviar instruções"
                    SemanticProperties.Hint="Solicita instruções de recuperação para o e-mail informado"
                    Command="{Binding SendResetCommand}"
                    IsEnabled="{Binding CanSendReset}"
                    HeightRequest="44"
                    CornerRadius="999"
                    BackgroundColor="{StaticResource Color.Primary}"
                    TextColor="{StaticResource Color.TextOnPrimary}"
                    FontAttributes="Bold" />

                <Label
                    Text="Voltar para login"
                    HorizontalOptions="Center"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Color.PrimaryLight}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>