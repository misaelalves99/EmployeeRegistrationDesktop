<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Auth.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Auth.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    BackgroundColor="{StaticResource Color.PageBackground}">

    <Grid Padding="32">
        <Border
            MaximumWidthRequest="480"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Padding="28"
            BackgroundColor="{StaticResource Color.CardBackground}"
            StrokeThickness="1"
            Stroke="{StaticResource Color.BorderSubtle}"
            StrokeShape="RoundRectangle 24"
            Shadow="{StaticResource Shadow.Card}">

            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Recuperar acesso"
                        SemanticProperties.HeadingLevel="Level1"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Color.TextPrimary}" />
                    <Label
                        Text="Informe seu e-mail. Nesta versão de demonstração, a solicitação é validada localmente e retorna ao login."
                        FontSize="13"
                        TextColor="{StaticResource Color.TextSecondary}" />
                </VerticalStackLayout>

                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="{StaticResource Color.DangerSoft}"
                    Stroke="{StaticResource Color.Danger}"
                    StrokeThickness="1"
                    Padding="8"
                    StrokeShape="RoundRectangle 12">
                    <Label
                        Text="{Binding ErrorMessage}"
                        FontSize="12"
                        TextColor="{StaticResource Color.Danger}" />
                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="E-mail"
                        FontSize="13"
                        TextColor="{StaticResource Color.TextSecondary}" />
                    <Entry
                        Text="{Binding Email}"
                        Placeholder="seu.email@empresa.com"
                        Keyboard="Email"
                        TextColor="{StaticResource Color.TextPrimary}"
                        PlaceholderColor="{StaticResource Color.TextMuted}"
                        BackgroundColor="{StaticResource Color.InputBackground}"
                        HeightRequest="42" />
                </VerticalStackLayout>

                <Button
                    Text="Enviar instruções"
                    Command="{Binding SendResetCommand}"
                    IsEnabled="{Binding CanSendReset}"
                    HeightRequest="44"
                    CornerRadius="999"
                    BackgroundColor="{StaticResource Color.Primary}"
                    TextColor="{StaticResource Color.TextOnPrimary}"
                    FontAttributes="Bold" />

                <Label
                    Text="Voltar para login"
                    HorizontalOptions="Center"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{StaticResource Color.PrimaryLight}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>