<!-- src/EmployeeRegistrationApp.Maui/Presentation/Auth/Views/RegisterPage.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Auth.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Auth.ViewModels"
    x:DataType="vm:RegisterViewModel"
    BackgroundColor="{StaticResource ColorBackgroundPage}">

    <Grid Padding="32">
        <!-- Overlay de carregamento -->
        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{StaticResource ColorPrimary}" />

        <Grid
            ColumnDefinitions="2*,*"
            RowDefinitions="*"
            MaximumWidthRequest="1024"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <!-- Lado esquerdo: painel de branding -->
            <Border
                Grid.Column="0"
                Padding="32"
                Margin="0,0,24,0"
                BackgroundColor="{StaticResource ColorPanelBackground}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="14" VerticalOptions="Center">
                    <Label
                        Text="Crie sua conta administrativa"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{StaticResource ColorTextPrimary}" />

                    <Label
                        Text="A conta de cadastro permite acesso ao dashboard completo de gestão de funcionários, departamentos, cargos e relatórios."
                        FontSize="13"
                        TextColor="{StaticResource ColorTextSecondary}" />

                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="•" TextColor="{StaticResource ColorPrimary}" />
                            <Label
                                Text="Controle de headcount por departamento."
                                FontSize="12"
                                TextColor="{StaticResource ColorTextSecondary}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="•" TextColor="{StaticResource ColorPrimary}" />
                            <Label
                                Text="Gestão de cargos, salários e status de vínculo."
                                FontSize="12"
                                TextColor="{StaticResource ColorTextSecondary}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="•" TextColor="{StaticResource ColorPrimary}" />
                            <Label
                                Text="Relatórios estratégicos para RH e diretoria."
                                FontSize="12"
                                TextColor="{StaticResource ColorTextSecondary}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Lado direito: formulário -->
            <Border
                Grid.Column="1"
                Padding="28"
                BackgroundColor="{StaticResource ColorCardBackground}"
                StrokeThickness="1"
                Stroke="{StaticResource ColorBorderSubtle}"
                StrokeShape="RoundRectangle 24"
                Shadow="{StaticResource ShadowCard}">
                <ScrollView>
                    <VerticalStackLayout Spacing="18">

                        <!-- Cabeçalho -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Criar conta"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{StaticResource ColorTextPrimary}" />
                            <Label
                                Text="Preencha os dados abaixo para configurar o primeiro usuário administrador."
                                FontSize="13"
                                TextColor="{StaticResource ColorTextSecondary}" />
                        </VerticalStackLayout>

                        <!-- Mensagem de erro -->
                        <Border
                            IsVisible="{Binding HasError}"
                            BackgroundColor="{StaticResource ColorDangerSoft}"
                            Stroke="{StaticResource ColorDanger}"
                            StrokeThickness="1"
                            Padding="8"
                            StrokeShape="RoundRectangle 12">
                            <Label
                                Text="{Binding ErrorMessage}"
                                FontSize="12"
                                TextColor="{StaticResource ColorDangerStrong}" />
                        </Border>

                        <!-- Nome completo -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Nome completo"
                                FontSize="13"
                                TextColor="{StaticResource ColorTextSecondary}" />
                            <Entry
                                Text="{Binding FullName}"
                                Placeholder="Seu nome completo"
                                TextColor="{StaticResource ColorTextPrimary}"
                                PlaceholderColor="{StaticResource ColorTextMuted}"
                                BackgroundColor="{StaticResource ColorInputBackground}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- E-mail -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="E-mail corporativo"
                                FontSize="13"
                                TextColor="{StaticResource ColorTextSecondary}" />
                            <Entry
                                Text="{Binding Email}"
                                Placeholder="seu.email@empresa.com"
                                Keyboard="Email"
                                TextColor="{StaticResource ColorTextPrimary}"
                                PlaceholderColor="{StaticResource ColorTextMuted}"
                                BackgroundColor="{StaticResource ColorInputBackground}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- Senha -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Senha"
                                FontSize="13"
                                TextColor="{StaticResource ColorTextSecondary}" />
                            <Entry
                                Text="{Binding Password}"
                                Placeholder="Crie uma senha segura"
                                IsPassword="True"
                                TextColor="{StaticResource ColorTextPrimary}"
                                PlaceholderColor="{StaticResource ColorTextMuted}"
                                BackgroundColor="{StaticResource ColorInputBackground}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- Confirmar senha -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Confirmar senha"
                                FontSize="13"
                                TextColor="{StaticResource ColorTextSecondary}" />
                            <Entry
                                Text="{Binding ConfirmPassword}"
                                Placeholder="Repita a senha"
                                IsPassword="True"
                                TextColor="{StaticResource ColorTextPrimary}"
                                PlaceholderColor="{StaticResource ColorTextMuted}"
                                BackgroundColor="{StaticResource ColorInputBackground}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- Política / termos (simples) -->
                        <HorizontalStackLayout Spacing="6" Padding="0,4,0,0">
                            <CheckBox
                                IsChecked="{Binding AcceptTerms}"
                                Color="{StaticResource ColorPrimary}" />
                            <Label
                                Text="Concordo com os termos de uso deste sistema interno."
                                FontSize="11"
                                VerticalOptions="Center"
                                TextColor="{StaticResource ColorTextSecondary}" />
                        </HorizontalStackLayout>

                        <!-- Botão registrar -->
                        <Button
                            Text="Criar conta"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding CanRegister}"
                            HeightRequest="44"
                            CornerRadius="999"
                            BackgroundColor="{StaticResource ColorPrimary}"
                            TextColor="{StaticResource ColorOnPrimary}"
                            FontAttributes="Bold" />

                        <!-- Já tem conta -->
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="4">
                            <Label
                                Text="Já possui uma conta?"
                                FontSize="12"
                                TextColor="{StaticResource ColorTextSecondary}" />
                            <Label
                                Text="Ir para login"
                                FontSize="12"
                                TextColor="{StaticResource ColorPrimarySoft}"
                                FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding NavigateToLoginCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
