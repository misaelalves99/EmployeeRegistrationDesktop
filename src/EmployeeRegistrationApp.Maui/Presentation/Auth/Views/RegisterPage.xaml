<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Auth.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Auth.ViewModels"
    x:DataType="vm:RegisterViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <Grid x:Name="RootLayout" Padding="32">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="AuthGrid" Property="Grid.ColumnDefinitions" Value="2*,*" />
                        <Setter TargetName="BrandPanel" Property="IsVisible" Value="True" />
                        <Setter TargetName="BrandPanel" Property="Grid.Column" Value="0" />
                        <Setter TargetName="BrandPanel" Property="Margin" Value="0,0,24,0" />
                        <Setter TargetName="FormPanel" Property="Grid.Column" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="AuthGrid" Property="Grid.ColumnDefinitions" Value="*" />
                        <Setter TargetName="BrandPanel" Property="IsVisible" Value="False" />
                        <Setter TargetName="BrandPanel" Property="Grid.Column" Value="0" />
                        <Setter TargetName="BrandPanel" Property="Margin" Value="0" />
                        <Setter TargetName="FormPanel" Property="Grid.Column" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!-- Overlay de carregamento -->
        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{StaticResource Color.Primary}" />

        <Grid
            x:Name="AuthGrid"
            ColumnDefinitions="2*,*"
            RowDefinitions="*"
            MaximumWidthRequest="1024"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <!-- Lado esquerdo: painel de branding -->
            <Border
                x:Name="BrandPanel"
                Grid.Column="0"
                Padding="32"
                Margin="0,0,24,0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Color.BrandSurface.Light}, Dark={StaticResource Color.BrandSurface}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="14" VerticalOptions="Center">
                    <Label
                        Text="Crie sua conta administrativa"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}" />

                    <Label
                        Text="A conta de cadastro permite acesso ao dashboard completo de gestão de funcionários, departamentos, cargos e relatórios."
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />

                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="•" TextColor="{StaticResource Color.Primary}" />
                            <Label
                                Text="Controle de headcount por departamento."
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="•" TextColor="{StaticResource Color.Primary}" />
                            <Label
                                Text="Gestão de cargos, salários e status de vínculo."
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="•" TextColor="{StaticResource Color.Primary}" />
                            <Label
                                Text="Relatórios estratégicos para RH e diretoria."
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Lado direito: formulário -->
            <Border
                x:Name="FormPanel"
                Grid.Column="1"
                Padding="28"
                BackgroundColor="{AppThemeBinding Light={StaticResource Color.CardBackground.Light}, Dark={StaticResource Color.CardBackground}}"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Color.BorderSubtle.Light}, Dark={StaticResource Color.BorderSubtle}}"
                StrokeShape="RoundRectangle 24"
                Shadow="{StaticResource Shadow.Card}">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="18">

                        <!-- Cabeçalho -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Criar conta"
                                SemanticProperties.HeadingLevel="Level1"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}" />
                            <Label
                                Text="Preencha os dados abaixo para configurar o primeiro usuário administrador."
                                FontSize="13"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                        </VerticalStackLayout>

                        <!-- Mensagem de erro -->
                        <Border
                            IsVisible="{Binding HasError}"
                            BackgroundColor="{StaticResource Color.DangerSoft}"
                            Stroke="{StaticResource Color.Danger}"
                            StrokeThickness="1"
                            Padding="8"
                            StrokeShape="RoundRectangle 12">
                            <Label
                                Text="{Binding ErrorMessage}"
                                FontSize="12"
                                TextColor="{StaticResource Color.Danger}" />
                        </Border>

                        <!-- Nome completo -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Nome completo"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                            <Entry
                                Text="{Binding FullName}"
                                SemanticProperties.Description="Nome completo"
                                Placeholder="Seu nome completo"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource Color.TextMuted.Light}, Dark={StaticResource Color.TextMuted}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- E-mail -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="E-mail corporativo"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                            <Entry
                                Text="{Binding Email}"
                                SemanticProperties.Description="E-mail corporativo"
                                Placeholder="seu.email@empresa.com"
                                Keyboard="Email"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource Color.TextMuted.Light}, Dark={StaticResource Color.TextMuted}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- Senha -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Senha"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                            <Entry
                                Text="{Binding Password}"
                                SemanticProperties.Description="Senha"
                                Placeholder="Crie uma senha segura"
                                IsPassword="True"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource Color.TextMuted.Light}, Dark={StaticResource Color.TextMuted}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- Confirmar senha -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Confirmar senha"
                                FontSize="13"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                            <Entry
                                Text="{Binding ConfirmPassword}"
                                SemanticProperties.Description="Confirmar senha"
                                Placeholder="Repita a senha"
                                IsPassword="True"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource Color.TextMuted.Light}, Dark={StaticResource Color.TextMuted}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- Política / termos (simples) -->
                        <HorizontalStackLayout Spacing="6" Padding="0,4,0,0">
                            <CheckBox
                                IsChecked="{Binding AcceptTerms}"
                                Color="{StaticResource Color.Primary}" />
                            <Label
                                Text="Concordo com os termos de uso deste sistema interno."
                                FontSize="11"
                                VerticalOptions="Center"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                        </HorizontalStackLayout>

                        <!-- Botão registrar -->
                        <Button
                            Text="Criar conta"
                            SemanticProperties.Hint="Cria a conta administrativa com os dados informados"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding CanRegister}"
                            HeightRequest="44"
                            CornerRadius="999"
                            BackgroundColor="{StaticResource Color.Primary}"
                            TextColor="{StaticResource Color.TextOnPrimary}"
                            FontAttributes="Bold" />

                        <!-- Já tem conta -->
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="4">
                            <Label
                                Text="Já possui uma conta?"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
                            <Label
                                Text="Ir para login"
                                FontSize="12"
                                TextColor="{StaticResource Color.PrimaryLight}"
                                FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding NavigateToLoginCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
