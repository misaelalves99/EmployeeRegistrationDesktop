<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Auth.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Auth.ViewModels"
    x:DataType="vm:LoginViewModel"
    BackgroundColor="{StaticResource Color.PageBackground}"
    xmlns:converters="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Converters">
    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid x:Name="RootLayout" Padding="32">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="AuthGrid" Property="Grid.ColumnDefinitions" Value="*,2*" />
                        <Setter TargetName="BrandPanel" Property="IsVisible" Value="True" />
                        <Setter TargetName="BrandPanel" Property="Grid.Column" Value="1" />
                        <Setter TargetName="BrandPanel" Property="Margin" Value="24,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="AuthGrid" Property="Grid.ColumnDefinitions" Value="*" />
                        <Setter TargetName="BrandPanel" Property="IsVisible" Value="False" />
                        <Setter TargetName="BrandPanel" Property="Grid.Column" Value="0" />
                        <Setter TargetName="BrandPanel" Property="Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!-- Overlay de carregamento -->
        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{StaticResource Color.Primary}" />

        <!-- Layout principal -->
        <Grid
            x:Name="AuthGrid"
            ColumnDefinitions="*,2*"
            RowDefinitions="*"
            MaximumWidthRequest="1024"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <!-- Lado esquerdo: formulário -->
            <Border
                Grid.Column="0"
                Padding="28"
                BackgroundColor="{StaticResource Color.CardBackground}"
                StrokeThickness="1"
                Stroke="{StaticResource Color.BorderSubtle}"
                StrokeShape="RoundRectangle 24"
                Shadow="{StaticResource Shadow.Card}">
                <ScrollView>
                    <VerticalStackLayout Spacing="18">

                        <!-- Cabeçalho -->
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Bem-vindo de volta 👋"
                                SemanticProperties.HeadingLevel="Level1"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Color.TextPrimary}" />

                            <Label
                                Text="Acesse o painel para gerenciar funcionários, departamentos e cargos."
                                FontSize="13"
                                TextColor="{StaticResource Color.TextSecondary}" />
                        </VerticalStackLayout>

                        <!-- Mensagem de erro -->
                        <Border
                            IsVisible="{Binding HasError}"
                            BackgroundColor="{StaticResource Color.DangerSoft}"
                            Stroke="{StaticResource Color.Danger}"
                            StrokeThickness="1"
                            Padding="8"
                            StrokeShape="RoundRectangle 12">
                            <Label
                                Text="{Binding ErrorMessage}"
                                FontSize="12"
                                TextColor="{StaticResource Color.Danger}" />
                        </Border>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="E-mail"
                                FontSize="13"
                                TextColor="{StaticResource Color.TextSecondary}" />
                            <Entry
                                Text="{Binding Email}"
                                SemanticProperties.Description="E-mail"
                                Placeholder="seu.email@empresa.com"
                                Keyboard="Email"
                                ClearButtonVisibility="WhileEditing"
                                TextColor="{StaticResource Color.TextPrimary}"
                                PlaceholderColor="{StaticResource Color.TextMuted}"
                                BackgroundColor="{StaticResource Color.InputBackground}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- Senha -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Senha"
                                FontSize="13"
                                TextColor="{StaticResource Color.TextSecondary}" />
                            <Entry
                                Text="{Binding Password}"
                                SemanticProperties.Description="Senha"
                                Placeholder="Digite sua senha"
                                IsPassword="True"
                                ClearButtonVisibility="WhileEditing"
                                TextColor="{StaticResource Color.TextPrimary}"
                                PlaceholderColor="{StaticResource Color.TextMuted}"
                                BackgroundColor="{StaticResource Color.InputBackground}"
                                HeightRequest="42" />
                        </VerticalStackLayout>

                        <!-- Lembrar-me / Esqueci minha senha (futuro) -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,4,0,0">
                            <Grid
                                Grid.Column="0"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="6">
                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{Binding RememberMe}"
                                    Color="{StaticResource Color.Primary}" />
                                <Label
                                    Grid.Column="1"
                                    Text="Lembrar-me neste dispositivo"
                                    FontSize="12"
                                    VerticalOptions="Center"
                                    LineBreakMode="TailTruncation"
                                    TextColor="{StaticResource Color.TextSecondary}" />
                            </Grid>

                            <Label
                                Grid.Column="1"
                                Text="Esqueci minha senha"
                                FontSize="12"
                                TextColor="{StaticResource Color.PrimaryLight}"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding NavigateToForgotPasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Botão login -->
                        <Button
                            Text="Entrar"
                            SemanticProperties.Hint="Entra no sistema com as credenciais informadas"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            HeightRequest="44"
                            CornerRadius="999"
                            BackgroundColor="{StaticResource Color.Primary}"
                            TextColor="{StaticResource Color.TextOnPrimary}"
                            FontAttributes="Bold" />

                        <!-- Separador -->
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                            <BoxView
                                Grid.Column="0"
                                HeightRequest="1"
                                BackgroundColor="{StaticResource Color.BorderSubtle}" />
                            <Label
                                Grid.Column="1"
                                Text="ou"
                                FontSize="11"
                                TextColor="{StaticResource Color.TextMuted}" />
                            <BoxView
                                Grid.Column="2"
                                HeightRequest="1"
                                BackgroundColor="{StaticResource Color.BorderSubtle}" />
                        </Grid>

                        <!-- Registro -->
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="4">
                            <Label
                                Text="Ainda não possui conta?"
                                FontSize="12"
                                TextColor="{StaticResource Color.TextSecondary}" />
                            <Label
                                Text="Criar conta"
                                FontSize="12"
                                TextColor="{StaticResource Color.PrimaryLight}"
                                FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding NavigateToRegisterCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- Lado direito: painel visual / branding -->
            <Border
                x:Name="BrandPanel"
                Grid.Column="1"
                Padding="32"
                Margin="24,0,0,0"
                BackgroundColor="{StaticResource Color.BrandSurface}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Logo / título -->
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Employee Registration"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Color.TextPrimary}" />
                        <Label
                            Text="Dashboard corporativo para gestão de pessoas, departamentos e cargos."
                            FontSize="13"
                            TextColor="{StaticResource Color.TextSecondary}"
                            MaxLines="3" />
                    </VerticalStackLayout>

                    <!-- Métricas / copy forte -->
                    <VerticalStackLayout
                        Grid.Row="1"
                        Spacing="12"
                        VerticalOptions="Center">
                        <Label
                            Text="Tenha visibilidade em tempo real do headcount, status e estrutura da sua empresa."
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Color.TextPrimary}" />

                        <Label
                            Text="Projeto focado em arquitetura limpa, domínio forte e experiência de dashboard moderna para times de RH e gestão."
                            FontSize="13"
                            TextColor="{StaticResource Color.TextSecondary}" />
                    </VerticalStackLayout>

                    <!-- Rodapé -->
                    <Label
                        Grid.Row="2"
                        Text="Versão Desktop · .NET MAUI · MVVM"
                        FontSize="11"
                        TextColor="{StaticResource Color.TextMuted}"
                        HorizontalOptions="End" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
