<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Settings.Views.CompanySettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Empresa"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ScrollView>
        <Grid
            Padding="24"
            RowSpacing="20"
            RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label
                    Text="Dados da empresa"
                    Style="{StaticResource PageTitleLabel}" />

                <Label
                    Text="Configure o nome fantasia, razão social e demais informações institucionais."
                    Style="{StaticResource BodySecondaryLabel}" />
            </VerticalStackLayout>

            <!-- Formulário -->
            <Frame Grid.Row="1" Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout>
                        <Label Text="Nome fantasia" Style="{StaticResource FieldLabel}" />
                        <Entry
                            Placeholder="Ex: Empresa Exemplo"
                            Text="{Binding CompanyName}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Razão social" Style="{StaticResource FieldLabel}" />
                        <Entry
                            Placeholder="Ex: Empresa Exemplo LTDA"
                            Text="{Binding LegalName}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label
                            Text="Observações internas (opcional)"
                            Style="{StaticResource FieldLabel}" />
                        <Editor
                            Placeholder="Informações adicionais sobre a empresa"
                            AutoSize="TextChanges"
                            HeightRequest="100"
                            Text="{Binding InternalNotes}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Botões -->
            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Button
                    Text="Cancelar"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />

                <Button
                    Grid.Column="1"
                    Text="Salvar"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>
