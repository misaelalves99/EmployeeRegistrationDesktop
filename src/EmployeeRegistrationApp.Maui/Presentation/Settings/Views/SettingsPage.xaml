<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Settings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Settings.ViewModels"
    x:DataType="viewModels:SettingsViewModel"
    Title="Configurações"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ScrollView>
        <Grid
            Padding="{StaticResource Spacing.PagePadding}"
            RowDefinitions="Auto,Auto,*"
            RowSpacing="{StaticResource Spacing.StackLarge}">

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="{StaticResource Spacing.XS}">

                <Label
                    Text="Configurações"
                    Style="{StaticResource PageTitleLabel}"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="Gerencie os parâmetros globais do sistema, os dados da empresa e a aparência da aplicação."
                    Style="{StaticResource BodySecondaryLabel}" />
            </VerticalStackLayout>

            <Frame
                Grid.Row="1"
                Style="{StaticResource CardFrameStyle}">

                <VerticalStackLayout Spacing="{StaticResource Spacing.S}">
                    <Label
                        Text="Visão geral"
                        Style="{StaticResource SectionTitleLabel}"
                        SemanticProperties.HeadingLevel="Level2" />

                    <Label
                        Text="{Binding CompanyNameSummary}"
                        Style="{StaticResource BodySecondaryLabel}" />

                    <Label
                        Text="{Binding CurrentThemeSummary}"
                        Style="{StaticResource SupportingLabel}" />
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout
                Grid.Row="2"
                Spacing="{StaticResource Spacing.StackMedium}">

                <Frame Style="{StaticResource CardFrameStyle}">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="{StaticResource Spacing.StackLarge}">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="{StaticResource Spacing.XS}">

                            <Label
                                Text="Configurações da empresa"
                                Style="{StaticResource SectionTitleLabel}"
                                SemanticProperties.HeadingLevel="Level2" />

                            <Label
                                Text="Atualize nome fantasia, razão social e demais informações institucionais."
                                Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Abrir"
                            Command="{Binding OpenCompanySettingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardFrameStyle}">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="{StaticResource Spacing.StackLarge}">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="{StaticResource Spacing.XS}">

                            <Label
                                Text="Tema da aplicação"
                                Style="{StaticResource SectionTitleLabel}"
                                SemanticProperties.HeadingLevel="Level2" />

                            <Label
                                Text="{Binding CurrentThemeSummary}"
                                Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="{Binding ThemeToggleButtonText}"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
