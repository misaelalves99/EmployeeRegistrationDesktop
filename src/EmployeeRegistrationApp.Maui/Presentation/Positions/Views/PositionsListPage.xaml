<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Positions.Views.PositionsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Positions.ViewModels"
    xmlns:dto="clr-namespace:EmployeeRegistrationApp.Application.DTOs.Positions;assembly=EmployeeRegistrationApp.Application"
    x:DataType="vm:PositionsListViewModel"
    Title="Cargos"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Novo"
            Priority="0"
            Order="Primary"
            Command="{Binding NewPositionCommand}" />
    </ContentPage.ToolbarItems>

    <Grid
        Padding="{StaticResource Spacing.PagePadding}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="{StaticResource Spacing.StackLarge}">

        <VerticalStackLayout Spacing="{StaticResource Spacing.XS}">
            <Label
                Text="Cargos"
                Style="{StaticResource PageTitleLabel}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Gerencie os cargos da empresa e visualize departamento e senioridade."
                Style="{StaticResource BodySecondaryLabel}" />
        </VerticalStackLayout>

        <SearchBar
            Grid.Row="1"
            Placeholder="Buscar cargos..."
            Text="{Binding SearchTerm}"
            SemanticProperties.Description="Buscar cargos por nome" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Positions}"
            SelectionMode="Single"
            SelectionChanged="OnSelectionChanged">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="{StaticResource Spacing.EmptyStatePadding}"
                    Spacing="{StaticResource Spacing.S}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="Nenhum cargo encontrado"
                        Style="{StaticResource SectionTitleLabel}"
                        HorizontalOptions="Center"
                        SemanticProperties.HeadingLevel="Level2" />

                    <Label
                        Text="Cadastre um novo cargo ou ajuste o filtro de busca."
                        Style="{StaticResource BodySecondaryLabel}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:PositionDto">
                    <Frame Style="{StaticResource CardFrameStyle}">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="{StaticResource Spacing.StackLarge}"
                            RowSpacing="{StaticResource Spacing.XS}">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Name}"
                                Style="{StaticResource SectionTitleLabel}"
                                SemanticProperties.HeadingLevel="Level2" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding DepartmentName}"
                                Style="{StaticResource BodySecondaryLabel}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1" />

                            <VerticalStackLayout
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Spacing="{StaticResource Spacing.XXS}"
                                HorizontalOptions="End"
                                VerticalOptions="Center">

                                <Label
                                    Text="Tipo"
                                    Style="{StaticResource SupportingLabel}"
                                    HorizontalOptions="End" />

                                <Label
                                    Text="{Binding Type}"
                                    Style="{StaticResource SectionTitleLabel}"
                                    HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
