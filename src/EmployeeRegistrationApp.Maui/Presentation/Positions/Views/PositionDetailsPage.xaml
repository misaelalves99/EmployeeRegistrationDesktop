<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Positions.Views.PositionDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalhes do Cargo">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Editar"
            Priority="0"
            Order="Primary"
            Command="{Binding EditCommand}" />

        <ToolbarItem
            Text="Excluir"
            Priority="1"
            Order="Primary"
            Command="{Binding DeleteCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="{Binding Name}"
                    FontAttributes="Bold"
                    FontSize="22" />
                <Label
                    Text="{Binding DepartmentName}"
                    FontSize="13"
                    Opacity="0.8" />
            </VerticalStackLayout>

            <!-- Resumo -->
            <Frame
                Padding="16"
                HasShadow="False"
                CornerRadius="12"
                BorderColor="{DynamicResource Color.BorderStrong}">
                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="16"
                    RowSpacing="8">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Tipo"
                        FontSize="13"
                        Opacity="0.7" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding TypeDisplay}"
                        FontAttributes="Bold"
                        FontSize="16" />

                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Faixa salarial"
                        FontSize="13"
                        Opacity="0.7" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding SalaryRangeDisplay}"
                        FontAttributes="Bold"
                        FontSize="16" />
                </Grid>
            </Frame>

            <!-- Situação -->
            <HorizontalStackLayout Spacing="8">
                <Label
                    Text="Status:"
                    FontAttributes="Bold" />
                <Label
                    Text="{Binding StatusDisplay}"
                    FontAttributes="Bold"
                    TextColor="{Binding StatusColor}" />
            </HorizontalStackLayout>

            <!-- Descrição -->
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Descrição"
                    FontAttributes="Bold"
                    FontSize="14" />
                <Label
                    Text="{Binding Description}"
                    FontSize="14"
                    Opacity="0.9" />
            </VerticalStackLayout>

            <!-- Datas -->
            <VerticalStackLayout Spacing="2">
                <Label
                    Text="{Binding CreatedAtDisplay}"
                    FontSize="12"
                    Opacity="0.6" />
                <Label
                    Text="{Binding UpdatedAtDisplay}"
                    FontSize="12"
                    Opacity="0.6" />
            </VerticalStackLayout>

            <!-- Ações -->
            <HorizontalStackLayout
                Spacing="12"
                HorizontalOptions="End">

                <Button
                    Text="Voltar"
                    Command="{Binding BackCommand}" Style="{StaticResource SecondaryButtonStyle}" />

                <Button
                    Text="Editar"
                    Command="{Binding EditCommand}"
                    BackgroundColor="{DynamicResource Color.Primary}"
                    TextColor="White" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
