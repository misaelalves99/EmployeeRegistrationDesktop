<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Departments.Views.DepartmentsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Departments.ViewModels"
    xmlns:dto="clr-namespace:EmployeeRegistrationApp.Application.DTOs.Departments;assembly=EmployeeRegistrationApp.Application"
    x:DataType="vm:DepartmentsListViewModel"
    Title="Departamentos"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Novo"
            Priority="0"
            Order="Primary"
            Command="{Binding NewDepartmentCommand}" />
    </ContentPage.ToolbarItems>

    <Grid
        Padding="{StaticResource Spacing.PagePadding}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="{StaticResource Spacing.StackLarge}">

        <VerticalStackLayout Spacing="{StaticResource Spacing.XS}">
            <Label
                Text="Departamentos"
                Style="{StaticResource PageTitleLabel}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Gerencie as áreas da empresa e acompanhe a distribuição de pessoas."
                Style="{StaticResource BodySecondaryLabel}" />
        </VerticalStackLayout>

        <SearchBar
            Grid.Row="1"
            Placeholder="Buscar departamento..."
            Text="{Binding SearchTerm}"
            SemanticProperties.Description="Buscar departamentos por nome ou descrição" />

        <RefreshView
            Grid.Row="2"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">

            <CollectionView
                x:Name="DepartmentsCollectionView"
                ItemsSource="{Binding Departments}"
                SelectionMode="Single"
                SelectionChanged="DepartmentsCollectionView_SelectionChanged">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="{StaticResource Spacing.EmptyStatePadding}"
                        Spacing="{StaticResource Spacing.S}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="Nenhum departamento encontrado"
                            Style="{StaticResource SectionTitleLabel}"
                            HorizontalOptions="Center"
                            SemanticProperties.HeadingLevel="Level2" />

                        <Label
                            Text="Use “Novo” para cadastrar o primeiro departamento."
                            Style="{StaticResource BodySecondaryLabel}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:DepartmentDto">
                        <Frame Style="{StaticResource CardFrameStyle}">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="{StaticResource Spacing.StackLarge}"
                                RowSpacing="{StaticResource Spacing.XS}">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Name}"
                                    Style="{StaticResource SectionTitleLabel}"
                                    SemanticProperties.HeadingLevel="Level2" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Description}"
                                    Style="{StaticResource BodySecondaryLabel}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />

                                <VerticalStackLayout
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Spacing="{StaticResource Spacing.XXS}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Headcount}"
                                        Style="{StaticResource SectionTitleLabel}"
                                        HorizontalOptions="End" />

                                    <Label
                                        Text="pessoas"
                                        Style="{StaticResource SupportingLabel}"
                                        HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
