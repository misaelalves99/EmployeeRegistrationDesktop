<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Departments.Views.DepartmentFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding PageTitle}"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="{Binding HeaderTitle}"
                    Style="{StaticResource PageTitleLabel}" />

                <Label
                    Text="{Binding HeaderSubtitle}"
                    Style="{StaticResource BodySecondaryLabel}" />
            </VerticalStackLayout>

            <!-- Nome -->
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Nome do departamento"
                    Style="{StaticResource FieldLabel}" />
                <Entry
                    Text="{Binding Name}"
                    Placeholder="Ex: Tecnologia da Informação" />
                <Label
                    Text="{Binding NameError}"
                    FontSize="12"
                    TextColor="Red"
                    IsVisible="{Binding HasNameError}" />
            </VerticalStackLayout>

            <!-- Descrição -->
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Descrição"
                    Style="{StaticResource FieldLabel}" />
                <Editor
                    Text="{Binding Description}"
                    AutoSize="TextChanges"
                    HeightRequest="120"
                    Placeholder="Resumo das responsabilidades do departamento..." />
            </VerticalStackLayout>

            <!-- Ações -->
            <HorizontalStackLayout
                Spacing="12"
                HorizontalOptions="End">

                <Button
                    Text="Cancelar"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />

                <Button
                    Text="Salvar"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
