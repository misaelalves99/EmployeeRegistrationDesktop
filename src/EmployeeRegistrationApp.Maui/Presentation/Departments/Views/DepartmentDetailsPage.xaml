<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Departments.Views.DepartmentDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Departments.ViewModels"
    x:DataType="vm:DepartmentDetailsViewModel"
    Title="Detalhes do Departamento"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Editar"
            Priority="0"
            Order="Primary"
            Command="{Binding EditCommand}" />

        <ToolbarItem
            Text="Excluir"
            Priority="1"
            Order="Primary"
            Command="{Binding DeleteCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <Grid
            Padding="{StaticResource Spacing.PagePadding}"
            RowDefinitions="Auto,Auto,Auto,Auto"
            RowSpacing="{StaticResource Spacing.StackLarge}">

            <VerticalStackLayout Spacing="{StaticResource Spacing.XS}">
                <Label
                    Text="{Binding Name}"
                    Style="{StaticResource PageTitleLabel}"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="{Binding CodeDisplay}"
                    Style="{StaticResource SupportingLabel}" />
            </VerticalStackLayout>

            <Frame
                Grid.Row="1"
                Style="{StaticResource CardFrameStyle}">

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="{StaticResource Spacing.StackLarge}"
                    RowSpacing="{StaticResource Spacing.S}">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Funcionários ativos"
                        Style="{StaticResource SupportingLabel}" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding ActiveEmployeesCount}"
                        Style="{StaticResource MetricValueLabel}" />

                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Total de funcionários"
                        Style="{StaticResource SupportingLabel}" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding TotalEmployeesCount}"
                        Style="{StaticResource MetricValueLabel}" />
                </Grid>
            </Frame>

            <VerticalStackLayout
                Grid.Row="2"
                Spacing="{StaticResource Spacing.XS}">

                <Label
                    Text="Descrição"
                    Style="{StaticResource SectionTitleLabel}"
                    SemanticProperties.HeadingLevel="Level2" />

                <Label
                    Text="{Binding Description}"
                    Style="{StaticResource BodySecondaryLabel}" />
            </VerticalStackLayout>

            <HorizontalStackLayout
                Grid.Row="3"
                Spacing="{StaticResource Spacing.M}"
                HorizontalOptions="End">

                <Button
                    Text="Voltar"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />

                <Button
                    Text="Editar"
                    Command="{Binding EditCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
