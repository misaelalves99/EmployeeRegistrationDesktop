<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Reports.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Reports.ViewModels"
    x:DataType="viewModels:ReportsViewModel"
    Title="Relatórios"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <Grid
        Padding="{StaticResource Spacing.PagePadding}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="{StaticResource Spacing.StackLarge}">

        <VerticalStackLayout Spacing="{StaticResource Spacing.XS}">
            <Label
                Text="Relatórios e indicadores"
                Style="{StaticResource PageTitleLabel}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Acompanhe headcount, distribuição de cargos e visão geral da força de trabalho da empresa."
                Style="{StaticResource BodySecondaryLabel}" />
        </VerticalStackLayout>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="{StaticResource Spacing.StackMedium}">

            <Frame
                Grid.Column="0"
                Style="{StaticResource CardFrameStyle}">

                <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                    <Label
                        Text="Headcount"
                        Style="{StaticResource SupportingLabel}" />

                    <Label
                        Text="{Binding HeadcountSummary}"
                        Style="{StaticResource MetricValueLabel}" />
                </VerticalStackLayout>
            </Frame>

            <Frame
                Grid.Column="1"
                Style="{StaticResource CardFrameStyle}">

                <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                    <Label
                        Text="Departamentos"
                        Style="{StaticResource SupportingLabel}" />

                    <Label
                        Text="{Binding DepartmentsSummary}"
                        Style="{StaticResource MetricValueLabel}" />
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="{StaticResource Spacing.StackMedium}">

                <Frame Style="{StaticResource CardFrameStyle}">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="{StaticResource Spacing.StackLarge}">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="{StaticResource Spacing.XS}">

                            <Label
                                Text="Headcount por departamento"
                                Style="{StaticResource SectionTitleLabel}"
                                SemanticProperties.HeadingLevel="Level2" />

                            <Label
                                Text="Veja quantos colaboradores existem em cada área, ativos e inativos, e identifique concentrações da equipe."
                                Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Abrir relatório"
                            Command="{Binding OpenHeadcountReportCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardFrameStyle}">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="{StaticResource Spacing.StackLarge}">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="{StaticResource Spacing.XS}">

                            <Label
                                Text="Resumo de salários (futuro)"
                                Style="{StaticResource SectionTitleLabel}"
                                SemanticProperties.HeadingLevel="Level2" />

                            <Label
                                Text="Planejado para consolidar salários médios, faixas e distribuição por cargo."
                                Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Em breve"
                            IsEnabled="False"
                            Style="{StaticResource TertiaryButtonStyle}"
                            VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
