<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Reports.Views.HeadcountByDepartmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Reports.ViewModels"
    x:DataType="viewModels:HeadcountByDepartmentViewModel"
    Title="Headcount por departamento"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <Grid
        Padding="{StaticResource Spacing.PagePadding}"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="{StaticResource Spacing.StackLarge}">

        <VerticalStackLayout Spacing="{StaticResource Spacing.XS}">
            <Label
                Text="Headcount por departamento"
                Style="{StaticResource PageTitleLabel}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Visualize a quantidade de colaboradores por área, separando ativos e inativos."
                Style="{StaticResource BodySecondaryLabel}" />
        </VerticalStackLayout>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="{StaticResource Spacing.M}"
            VerticalOptions="Center">

            <Label
                Grid.Column="0"
                Text="Período"
                Style="{StaticResource FieldLabel}"
                VerticalOptions="Center" />

            <Picker
                Grid.Column="1"
                Title="Selecione"
                ItemsSource="{Binding Periods}"
                ItemDisplayBinding="{Binding}"
                SelectedItem="{Binding SelectedPeriod}"
                HorizontalOptions="Fill" />

            <Button
                Grid.Column="2"
                Text="Atualizar"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy, Mode=OneWay}">

            <CollectionView
                ItemsSource="{Binding HeadcountItems}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="{StaticResource Spacing.EmptyStatePadding}"
                        Spacing="{StaticResource Spacing.S}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="Nenhum dado encontrado para o filtro atual."
                            Style="{StaticResource BodySecondaryLabel}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:HeadcountItemViewModel">
                        <Frame Style="{StaticResource CardFrameStyle}">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="{StaticResource Spacing.StackLarge}"
                                RowSpacing="{StaticResource Spacing.S}">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding DepartmentName}"
                                    Style="{StaticResource SectionTitleLabel}"
                                    SemanticProperties.HeadingLevel="Level2" />

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding TotalEmployees}"
                                    Style="{StaticResource MetricValueLabel}"
                                    HorizontalTextAlignment="End" />

                                <HorizontalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="{StaticResource Spacing.L}">

                                    <HorizontalStackLayout Spacing="{StaticResource Spacing.XS}">
                                        <BoxView
                                            WidthRequest="10"
                                            HeightRequest="10"
                                            CornerRadius="{StaticResource Radius.Pill}"
                                            Color="{StaticResource Color.Success}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="{Binding ActiveEmployees, StringFormat='Ativos: {0}'}"
                                            Style="{StaticResource SupportingLabel}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="{StaticResource Spacing.XS}">
                                        <BoxView
                                            WidthRequest="10"
                                            HeightRequest="10"
                                            CornerRadius="{StaticResource Radius.Pill}"
                                            Color="{StaticResource Color.Warning}"
                                            VerticalOptions="Center" />

                                        <Label
                                            Text="{Binding InactiveEmployees, StringFormat='Inativos: {0}'}"
                                            Style="{StaticResource SupportingLabel}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding PercentageInWorkforce, StringFormat='Participação: {0:P1}'}"
                                    Style="{StaticResource SupportingLabel}"
                                    HorizontalTextAlignment="End"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
