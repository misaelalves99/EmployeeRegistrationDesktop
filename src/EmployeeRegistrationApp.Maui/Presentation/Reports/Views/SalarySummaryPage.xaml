<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Reports.Views.SalarySummaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Reports.ViewModels"
    Title="Resumo de salários"
    xmlns:converters="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Converters">

    <ContentPage.Resources>
        <converters:MoneyToCurrencyStringConverter x:Key="MoneyToCurrencyStringConverter" />
        <Style TargetType="Label" x:Key="PageTitle">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        </Style>

        <Style TargetType="Label" x:Key="PageSubtitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource Color.TextSecondary}" />
        </Style>

        <Style TargetType="Frame" x:Key="SummaryCard">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BackgroundColor" Value="{StaticResource Color.CardBackground}" />
            <Setter Property="HasShadow" Value="False" />
        </Style>

        <Style TargetType="Frame" x:Key="DepartmentCard">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BackgroundColor" Value="{StaticResource Color.CardBackground}" />
            <Setter Property="HasShadow" Value="False" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="24"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="18">

        <!-- Cabeçalho -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Resumo de salários"
                   Style="{StaticResource PageTitle}" />

            <Label Text="Acompanhe massa salarial, salários médios e distribuição por departamento."
                   Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>

        <!-- Cards de resumo -->
        <HorizontalStackLayout Grid.Row="1" Spacing="12">
            <Frame Style="{StaticResource SummaryCard}" HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Massa salarial total"
                           FontSize="12"
                           TextColor="{StaticResource Color.TextSecondary}" />
                    <Label FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Color.TextPrimary}"
                           Text="{Binding TotalPayroll, Converter={StaticResource MoneyToCurrencyStringConverter}}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource SummaryCard}" HorizontalOptions="FillAndExpand">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Salário médio"
                           FontSize="12"
                           TextColor="{StaticResource Color.TextSecondary}" />
                    <Label FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Color.TextPrimary}"
                           Text="{Binding AverageSalary, Converter={StaticResource MoneyToCurrencyStringConverter}}" />
                </VerticalStackLayout>
            </Frame>
        </HorizontalStackLayout>

        <!-- Lista detalhada por departamento -->
        <RefreshView Grid.Row="2"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding SalaryItems}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40,60"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="Nenhum dado de salário encontrado para o filtro atual."
                               FontSize="14"
                               TextColor="{StaticResource Color.TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource DepartmentCard}" Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="6">

                                <!-- Nome do departamento -->
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding DepartmentName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Color.TextPrimary}" />

                                <!-- Folha do depto -->
                                <Label Grid.Row="0"
                                       Grid.Column="1"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="{StaticResource Color.TextPrimary}"
                                       Text="{Binding TotalDepartmentPayroll, Converter={StaticResource MoneyToCurrencyStringConverter}}" />

                                <!-- Linha de detalhes -->
                                <HorizontalStackLayout Grid.Row="1"
                                                       Grid.Column="0"
                                                       Grid.ColumnSpan="2"
                                                       Spacing="18">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Médio"
                                               FontSize="11"
                                               TextColor="{StaticResource Color.TextSecondary}" />
                                        <Label FontSize="13"
                                               TextColor="{StaticResource Color.TextPrimary}"
                                               Text="{Binding AverageSalary, Converter={StaticResource MoneyToCurrencyStringConverter}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Mínimo"
                                               FontSize="11"
                                               TextColor="{StaticResource Color.TextSecondary}" />
                                        <Label FontSize="13"
                                               TextColor="{StaticResource Color.TextPrimary}"
                                               Text="{Binding MinSalary, Converter={StaticResource MoneyToCurrencyStringConverter}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Máximo"
                                               FontSize="11"
                                               TextColor="{StaticResource Color.TextSecondary}" />
                                        <Label FontSize="13"
                                               TextColor="{StaticResource Color.TextPrimary}"
                                               Text="{Binding MaxSalary, Converter={StaticResource MoneyToCurrencyStringConverter}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="% folha"
                                               FontSize="11"
                                               TextColor="{StaticResource Color.TextSecondary}" />
                                        <Label FontSize="13"
                                               TextColor="{StaticResource Color.TextPrimary}"
                                               Text="{Binding PercentageOfTotal, StringFormat='{0:P1}'}" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
