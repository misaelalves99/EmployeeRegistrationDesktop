<ContentView
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Common.Controls.MetricCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Frame
        Padding="14"
        Margin="0,4"
        CornerRadius="14"
        HasShadow="False"
        BackgroundColor="#020617"
        BorderColor="#1f2937">

        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
            <!-- Título -->
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Text="{Binding Title, Source={x:Reference Root}}"
                FontSize="13"
                TextColor="#9ca3af" />

            <!-- Ícone -->
            <Label
                Grid.Row="0"
                Grid.Column="1"
                HorizontalOptions="End"
                FontSize="20"
                Text="{Binding Icon, Source={x:Reference Root}}"
                TextColor="#6b7280" />

            <!-- Valor -->
            <Label
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,6,0,2"
                Text="{Binding Value, Source={x:Reference Root}}"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#e5e7eb" />

            <!-- Rodapé: subtítulo + tendência -->
            <StackLayout
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Spacing="6">

                <Label
                    Text="{Binding Subtitle, Source={x:Reference Root}}"
                    FontSize="12"
                    TextColor="#6b7280" />

                <Label
                    x:Name="TrendLabel"
                    FontSize="12"
                    FontAttributes="Bold" />
            </StackLayout>
        </Grid>
    </Frame>
</ContentView>
