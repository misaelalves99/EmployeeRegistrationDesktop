<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Common.Controls.MetricCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Frame
        Padding="14"
        Margin="0,4"
        CornerRadius="14"
        HasShadow="False"
        BackgroundColor="{AppThemeBinding Light={StaticResource Color.CardBackground.Light}, Dark={StaticResource Color.CardBackground}}"
        BorderColor="{AppThemeBinding Light={StaticResource Color.BorderSubtle.Light}, Dark={StaticResource Color.BorderSubtle}}">

        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
            <!-- Título -->
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Text="{Binding Title, Source={x:Reference Root}}"
                FontSize="13"
                TextColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />

            <!-- Ícone -->
            <Label
                Grid.Row="0"
                Grid.Column="1"
                HorizontalOptions="End"
                FontSize="20"
                Text="{Binding Icon, Source={x:Reference Root}}"
                TextColor="{Binding AccentColor, Source={x:Reference Root}}" />

            <!-- Valor -->
            <Label
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,6,0,2"
                Text="{Binding Value, Source={x:Reference Root}}"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}" />

            <!-- Rodapé: subtítulo + tendência -->
            <StackLayout
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Spacing="6">

                <Label
                    Text="{Binding Subtitle, Source={x:Reference Root}}"
                    FontSize="12"
                    TextColor="{AppThemeBinding Light={StaticResource Color.TextMuted.Light}, Dark={StaticResource Color.TextMuted}}" />

                <Label
                    x:Name="TrendLabel"
                    FontSize="12"
                    FontAttributes="Bold" />
            </StackLayout>
        </Grid>
    </Frame>
</ContentView>
