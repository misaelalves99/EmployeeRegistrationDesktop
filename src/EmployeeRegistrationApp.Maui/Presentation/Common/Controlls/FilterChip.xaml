<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Common.Controls.FilterChip"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ContentView.Resources>
        <ResourceDictionary>
            <Color x:Key="ChipBg">#101A2E</Color>
            <Color x:Key="ChipBgSelected">#60A5FA</Color>
            <Color x:Key="ChipText">#E5E7EB</Color>
            <Color x:Key="ChipTextSelected">#0B1220</Color>
        </ResourceDictionary>
    </ContentView.Resources>

    <Frame
        Padding="12,8"
        CornerRadius="999"
        BorderColor="#1F2A44"
        BackgroundColor="{StaticResource ChipBg}">
        <Grid>
            <Label
                x:Name="ChipLabel"
                Text="{Binding Text, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                TextColor="{StaticResource ChipText}"
                FontSize="12"
                FontAttributes="Bold" />
        </Grid>

        <Frame.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Frame.GestureRecognizers>
    </Frame>
</ContentView>
