<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Common.Controls.AppShellHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        Padding="16,12"
        ColumnDefinitions="Auto,*,Auto"
        RowDefinitions="Auto,Auto"
        BackgroundColor="#020617">

        <!-- Ícone à esquerda -->
        <Frame
            Grid.RowSpan="2"
            WidthRequest="40"
            HeightRequest="40"
            CornerRadius="20"
            Margin="0,0,12,0"
            BackgroundColor="#1f2937"
            HasShadow="False"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            <Label
                x:Name="IconLabel"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                FontSize="20"
                Text="{Binding Icon, Source={x:Reference Root}}"
                TextColor="#e5e7eb" />
        </Frame>

        <!-- Título -->
        <Label
            x:Name="TitleLabel"
            x:FieldModifier="public"
            Grid.Column="1"
            Grid.Row="0"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="#e5e7eb"
            Text="{Binding Title, Source={x:Reference Root}}" />

        <!-- Subtítulo -->
        <Label
            x:Name="SubtitleLabel"
            Grid.Column="1"
            Grid.Row="1"
            Margin="0,2,0,0"
            FontSize="13"
            TextColor="#9ca3af"
            LineBreakMode="TailTruncation"
            Text="{Binding Subtitle, Source={x:Reference Root}}" />

        <!-- Área direita: nome do usuário + slot extra -->
        <StackLayout
            Grid.Column="2"
            Grid.RowSpan="2"
            Orientation="Horizontal"
            Spacing="8"
            VerticalOptions="Center"
            HorizontalOptions="End">

            <!-- Nome do usuário -->
            <Label
                x:Name="UserNameLabel"
                VerticalOptions="Center"
                FontSize="13"
                TextColor="#e5e7eb"
                Text="{Binding UserName, Source={x:Reference Root}}" />

            <!-- Avatar simples com iniciais -->
            <Frame
                WidthRequest="32"
                HeightRequest="32"
                CornerRadius="16"
                BackgroundColor="#2563eb"
                HasShadow="False"
                Padding="0"
                VerticalOptions="Center">
                <Label
                    x:Name="UserInitialsLabel"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="White" />
            </Frame>
        </StackLayout>
    </Grid>
</ContentView>
