<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Employees.Views.EmployeeReactivatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Employees.ViewModels"
    x:DataType="viewModels:EmployeeReactivateViewModel"
    Title="Reativar"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ScrollView>
        <Grid
            Padding="{StaticResource Spacing.PagePadding}"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="{StaticResource Spacing.StackLarge}">

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="{StaticResource Spacing.XS}">
                <Label
                    Text="Reativar colaborador"
                    Style="{StaticResource PageTitleLabel}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="Confirme a data de reativação para restabelecer o status do colaborador."
                    Style="{StaticResource BodySecondaryLabel}" />
            </VerticalStackLayout>

            <Frame
                Grid.Row="1"
                Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="{StaticResource Spacing.M}">
                    <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                        <Label
                            Text="Colaborador"
                            Style="{StaticResource FieldLabel}" />
                        <Label
                            Text="{Binding EmployeeName}"
                            Style="{StaticResource SectionTitleLabel}"
                            SemanticProperties.HeadingLevel="Level2" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                        <Label
                            Text="Data de reativação"
                            Style="{StaticResource FieldLabel}" />
                        <DatePicker
                            Date="{Binding ReactivationDate}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}"
                            TextColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}"
                            SemanticProperties.Description="Data escolhida para reativar o colaborador" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout
                Grid.Row="2"
                Spacing="{StaticResource Spacing.S}">
                <Button
                    Text="Confirmar reativação"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ConfirmCommand}" />
                <Button
                    Text="Cancelar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
