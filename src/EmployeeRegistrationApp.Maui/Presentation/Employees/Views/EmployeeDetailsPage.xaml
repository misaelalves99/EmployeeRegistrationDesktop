<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Employees.Views.EmployeeDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Employees.ViewModels"
    x:DataType="viewModels:EmployeeDetailsViewModel"
    Title="Detalhes"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ScrollView>
        <Grid
            Padding="{StaticResource Spacing.PagePadding}"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="{StaticResource Spacing.StackLarge}">

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="{StaticResource Spacing.XS}">
                <Label
                    Text="Detalhes do colaborador"
                    Style="{StaticResource PageTitleLabel}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="Consulte os dados cadastrais, vínculo profissional e ações disponíveis."
                    Style="{StaticResource BodySecondaryLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout
                Grid.Row="1"
                Spacing="{StaticResource Spacing.StackMedium}">

                <Frame Style="{StaticResource CardFrameStyle}">
                    <VerticalStackLayout Spacing="{StaticResource Spacing.S}">
                        <Label
                            Text="{Binding Employee.FullName}"
                            Style="{StaticResource SectionTitleLabel}"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label
                            Text="{Binding Employee.Email}"
                            Style="{StaticResource BodySecondaryLabel}" />
                        <Label
                            Text="{Binding Employee.IsActive, StringFormat='Ativo: {0}'}"
                            Style="{StaticResource StatusBadgeLabelStyle}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrameStyle}">
                    <VerticalStackLayout Spacing="{StaticResource Spacing.M}">
                        <Label
                            Text="Dados cadastrais"
                            Style="{StaticResource SectionTitleLabel}"
                            SemanticProperties.HeadingLevel="Level2" />

                        <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                            <Label Text="CPF" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding Employee.Cpf}" Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                            <Label Text="Telefone" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding Employee.PhoneNumber}" Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                            <Label Text="Departamento" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding Employee.DepartmentName}" Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                            <Label Text="Cargo" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding Employee.PositionName}" Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                            <Label Text="Contrato" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding Employee.ContractTypeLabel}" Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="{StaticResource Spacing.XXS}">
                            <Label Text="Status" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding Employee.EmploymentStatusLabel}" Style="{StaticResource BodySecondaryLabel}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <Frame
                Grid.Row="2"
                Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="{StaticResource Spacing.S}">
                    <Label
                        Text="Ações"
                        Style="{StaticResource SectionTitleLabel}"
                        SemanticProperties.HeadingLevel="Level2" />

                    <Button
                        Text="Editar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding EditCommand}" />

                    <Button
                        Text="Desativar"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DeactivateCommand}" />

                    <Button
                        Text="Reativar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ReactivateCommand}" />

                    <Button
                        Text="Excluir"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DeleteCommand}" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>
