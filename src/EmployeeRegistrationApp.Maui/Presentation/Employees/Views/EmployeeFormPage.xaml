<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Employees.Views.EmployeeFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Cadastro">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="BgPage">#0B1220</Color>
            <Color x:Key="BgCard">#101A2E</Color>
            <Color x:Key="TextPrimary">#E5E7EB</Color>
            <Color x:Key="TextMuted">#94A3B8</Color>
            <Color x:Key="Accent">#60A5FA</Color>

            <Style x:Key="CardFrameStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
                <Setter Property="BorderColor" Value="#1F2A44" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>

            <Style x:Key="TitleStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="MutedStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="TextColor" Value="#0B1220" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="{StaticResource BgPage}">
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding PageTitle}" Style="{StaticResource TitleStyle}" />

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Nome completo" Style="{StaticResource MutedStyle}" />
                    <Entry Placeholder="Ex: Misael Alves" Text="{Binding Form.FullName}" />

                    <Label Text="E-mail" Style="{StaticResource MutedStyle}" />
                    <Entry Placeholder="email@empresa.com" Keyboard="Email" Text="{Binding Form.Email}" />

                    <Label Text="CPF" Style="{StaticResource MutedStyle}" />
                    <Entry Placeholder="000.000.000-00" Keyboard="Numeric" Text="{Binding Form.Cpf}" />

                    <Label Text="Telefone" Style="{StaticResource MutedStyle}" />
                    <Entry Placeholder="(00) 9 0000-0000" Keyboard="Telephone" Text="{Binding Form.PhoneNumber}" />

                    <Label Text="Salário (BRL)" Style="{StaticResource MutedStyle}" />
                    <Entry Placeholder="Ex: 3500" Keyboard="Numeric" Text="{Binding SalaryText}" />

                </VerticalStackLayout>
            </Frame>

            <Button Text="Salvar" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
            <Button Text="Cancelar" Command="{Binding CancelCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
