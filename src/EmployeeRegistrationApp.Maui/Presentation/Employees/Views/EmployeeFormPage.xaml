<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Employees.Views.EmployeeFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Employees.ViewModels"
    x:DataType="viewModels:EmployeeFormViewModel"
    Title="Cadastro"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ScrollView>
        <VerticalStackLayout
            Padding="{StaticResource Spacing.PagePadding}"
            Spacing="{StaticResource Spacing.StackMedium}">

            <Label
                Text="{Binding PageTitle}"
                Style="{StaticResource PageTitleLabel}"
                SemanticProperties.HeadingLevel="Level1" />

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="{StaticResource Spacing.M}">

                    <Label Text="Nome completo" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Ex: Misael Alves" Text="{Binding Form.FullName}" />

                    <Label Text="E-mail" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="email@empresa.com" Keyboard="Email" Text="{Binding Form.Email}" />

                    <Label Text="CPF" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="000.000.000-00" Keyboard="Numeric" Text="{Binding Form.Cpf}" />

                    <Label Text="Telefone" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="(00) 9 0000-0000" Keyboard="Telephone" Text="{Binding Form.PhoneNumber}" />

                    <Label Text="Departamento" Style="{StaticResource FieldLabel}" />
                    <Picker
                        Title="Selecionar"
                        ItemsSource="{Binding Departments}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedDepartment}" />

                    <Label Text="Cargo" Style="{StaticResource FieldLabel}" />
                    <Picker
                        Title="Selecionar"
                        ItemsSource="{Binding Positions}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedPosition}" />

                    <Label Text="Contrato" Style="{StaticResource FieldLabel}" />
                    <Picker
                        Title="Selecionar"
                        ItemsSource="{Binding ContractTypes}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedContractType}" />

                    <Label Text="Salário (BRL)" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Ex: 3500" Keyboard="Numeric" Text="{Binding SalaryText}" />

                </VerticalStackLayout>
            </Frame>

            <Button
                Text="Salvar"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding SaveCommand}" />

            <Button
                Text="Cancelar"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding CancelCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
