<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Employees.Views.EmployeeFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Cadastro"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label
                Text="{Binding PageTitle}"
                Style="{StaticResource PageTitleLabel}" />

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Nome completo" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Ex: Misael Alves" Text="{Binding Form.FullName}" />

                    <Label Text="E-mail" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="email@empresa.com" Keyboard="Email" Text="{Binding Form.Email}" />

                    <Label Text="CPF" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="000.000.000-00" Keyboard="Numeric" Text="{Binding Form.Cpf}" />

                    <Label Text="Telefone" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="(00) 9 0000-0000" Keyboard="Telephone" Text="{Binding Form.PhoneNumber}" />

                    <Label Text="Salário (BRL)" Style="{StaticResource FieldLabel}" />
                    <Entry Placeholder="Ex: 3500" Keyboard="Numeric" Text="{Binding SalaryText}" />

                </VerticalStackLayout>
            </Frame>

            <Button
                Text="Salvar"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding SaveCommand}" />

            <Button
                Text="Cancelar"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding CancelCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
