<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Dashboard.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Dashboard.ViewModels"
    xmlns:controls="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Common.Controls"
    x:DataType="vm:DashboardViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}">

    <Grid x:Name="RootGrid" Padding="{StaticResource Spacing.PagePadding}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="RootGrid" Property="Padding" Value="{StaticResource Spacing.PagePaddingWide}" />
                        <Setter TargetName="DashboardHeader" Property="Grid.ColumnDefinitions" Value="*,Auto" />
                        <Setter TargetName="DashboardHeader" Property="Grid.RowDefinitions" Value="Auto" />
                        <Setter TargetName="RefreshButton" Property="Grid.Row" Value="0" />
                        <Setter TargetName="RefreshButton" Property="Grid.Column" Value="1" />
                        <Setter TargetName="RefreshButton" Property="HorizontalOptions" Value="End" />
                        <Setter TargetName="RefreshButton" Property="Margin" Value="8,0,0,0" />
                        <Setter TargetName="PrimaryMetricsGrid" Property="Grid.ColumnDefinitions" Value="*,*,*,*" />
                        <Setter TargetName="MetricActive" Property="Grid.Column" Value="1" />
                        <Setter TargetName="MetricInactive" Property="Grid.Column" Value="2" />
                        <Setter TargetName="MetricDepartments" Property="Grid.Column" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="RootGrid" Property="Padding" Value="{StaticResource Spacing.PagePadding}" />
                        <Setter TargetName="DashboardHeader" Property="Grid.ColumnDefinitions" Value="*" />
                        <Setter TargetName="DashboardHeader" Property="Grid.RowDefinitions" Value="Auto,Auto" />
                        <Setter TargetName="RefreshButton" Property="Grid.Row" Value="1" />
                        <Setter TargetName="RefreshButton" Property="Grid.Column" Value="0" />
                        <Setter TargetName="RefreshButton" Property="HorizontalOptions" Value="Start" />
                        <Setter TargetName="RefreshButton" Property="Margin" Value="0,12,0,0" />
                        <Setter TargetName="PrimaryMetricsGrid" Property="Grid.ColumnDefinitions" Value="*,*" />
                        <Setter TargetName="PrimaryMetricsGrid" Property="Grid.RowDefinitions" Value="Auto,Auto" />
                        <Setter TargetName="MetricActive" Property="Grid.Column" Value="1" />
                        <Setter TargetName="MetricInactive" Property="Grid.Row" Value="1" />
                        <Setter TargetName="MetricInactive" Property="Grid.Column" Value="0" />
                        <Setter TargetName="MetricDepartments" Property="Grid.Row" Value="1" />
                        <Setter TargetName="MetricDepartments" Property="Grid.Column" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{StaticResource Color.Primary}" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource Spacing.XL}" Padding="0,4,0,24">

                <Grid x:Name="DashboardHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                    <VerticalStackLayout Spacing="{StaticResource Spacing.XS}">
                        <Label
                            Text="Dashboard de Pessoas"
                            Style="{StaticResource PageTitleLabel}"
                            SemanticProperties.HeadingLevel="Level1" />
                        <Label
                            Text="Visão geral de headcount, departamentos e posições ativas."
                            Style="{StaticResource BodySecondaryLabel}" />
                    </VerticalStackLayout>

                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="1"
                        Text="Atualizar"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource CompactButtonStyle}"
                        SemanticProperties.Hint="Atualiza os indicadores e o resumo do dashboard"
                        Margin="8,0,0,0" />
                </Grid>

                <Grid x:Name="PrimaryMetricsGrid" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" ColumnSpacing="{StaticResource Spacing.M}" RowSpacing="{StaticResource Spacing.M}">
                    <controls:MetricCard x:Name="MetricTotal" Grid.Column="0" Title="Total de funcionários" Value="{Binding TotalEmployees}" Subtitle="Todos os vínculos" Icon="👥" AccentColor="{StaticResource Color.Primary}" />
                    <controls:MetricCard x:Name="MetricActive" Grid.Column="1" Title="Ativos" Value="{Binding ActiveEmployees}" Subtitle="Trabalhando atualmente" Icon="✅" AccentColor="{StaticResource Color.Success}" />
                    <controls:MetricCard x:Name="MetricInactive" Grid.Column="2" Title="Inativos" Value="{Binding InactiveEmployees}" Subtitle="Desligados / afastados" Icon="⚠️" AccentColor="{StaticResource Color.Warning}" />
                    <controls:MetricCard x:Name="MetricDepartments" Grid.Column="3" Title="Departamentos" Value="{Binding DepartmentsCount}" Subtitle="Áreas organizadas" Icon="🏢" AccentColor="{StaticResource Color.Info}" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Spacing.M}">
                    <controls:MetricCard Grid.Column="0" Title="Cargos cadastrados" Value="{Binding PositionsCount}" Subtitle="Níveis e funções" Icon="📌" AccentColor="{StaticResource Color.Primary}" />
                    <controls:MetricCard Grid.Column="1" Title="Média salarial" Value="{Binding AverageSalaryDisplay}" Subtitle="Base global" Icon="💰" AccentColor="{StaticResource Color.Accent}" />
                </Grid>

                <Border
                    Padding="{StaticResource Spacing.CardPadding}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Color.CardBackground.Light}, Dark={StaticResource Color.CardBackground}}"
                    Stroke="{AppThemeBinding Light={StaticResource Color.BorderSubtle.Light}, Dark={StaticResource Color.BorderSubtle}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="{StaticResource Spacing.S}">
                        <Label Text="Resumo de headcount" Style="{StaticResource SectionTitleLabel}" SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{Binding HeadcountSummary}" Style="{StaticResource BodySecondaryLabel}" />
                        <Label Text="{Binding LastUpdatedDisplay}" Style="{StaticResource SupportingLabel}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
