<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EmployeeRegistrationApp.Maui.Presentation.Dashboard.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Dashboard.ViewModels"
    xmlns:controls="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Common.Controls"
    x:DataType="vm:DashboardViewModel"
    BackgroundColor="{StaticResource Color.PageBackground}">

    <Grid Padding="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="PrimaryMetricsGrid" Property="Grid.ColumnDefinitions" Value="*,*,*,*" />
                        <Setter TargetName="MetricActive" Property="Grid.Column" Value="1" />
                        <Setter TargetName="MetricInactive" Property="Grid.Column" Value="2" />
                        <Setter TargetName="MetricDepartments" Property="Grid.Column" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="PrimaryMetricsGrid" Property="Grid.ColumnDefinitions" Value="*,*" />
                        <Setter TargetName="PrimaryMetricsGrid" Property="Grid.RowDefinitions" Value="Auto,Auto" />
                        <Setter TargetName="MetricActive" Property="Grid.Column" Value="1" />
                        <Setter TargetName="MetricInactive" Property="Grid.Row" Value="1" />
                        <Setter TargetName="MetricInactive" Property="Grid.Column" Value="0" />
                        <Setter TargetName="MetricDepartments" Property="Grid.Row" Value="1" />
                        <Setter TargetName="MetricDepartments" Property="Grid.Column" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="{StaticResource Color.Primary}" />

        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="0,4,0,24">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Dashboard de Pessoas"
                            SemanticProperties.HeadingLevel="Level1"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Color.TextPrimary}" />
                        <Label
                            Text="Visão geral de headcount, departamentos e posições ativas."
                            FontSize="13"
                            TextColor="{StaticResource Color.TextSecondary}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="Atualizar"
                        Command="{Binding RefreshCommand}"
                        HeightRequest="36"
                        CornerRadius="999"
                        BackgroundColor="{StaticResource Color.Primary}"
                        TextColor="{StaticResource Color.TextOnPrimary}"
                        FontSize="12"
                        Margin="8,0,0,0" />
                </Grid>

                <Grid x:Name="PrimaryMetricsGrid" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" ColumnSpacing="12" RowSpacing="12">
                    <controls:MetricCard x:Name="MetricTotal" Grid.Column="0" Title="Total de funcionários" Value="{Binding TotalEmployees}" Subtitle="Todos os vínculos" Icon="👥" AccentColor="{StaticResource Color.Primary}" />
                    <controls:MetricCard x:Name="MetricActive" Grid.Column="1" Title="Ativos" Value="{Binding ActiveEmployees}" Subtitle="Trabalhando atualmente" Icon="✅" AccentColor="{StaticResource Color.Success}" />
                    <controls:MetricCard x:Name="MetricInactive" Grid.Column="2" Title="Inativos" Value="{Binding InactiveEmployees}" Subtitle="Desligados / afastados" Icon="⚠️" AccentColor="{StaticResource Color.Warning}" />
                    <controls:MetricCard x:Name="MetricDepartments" Grid.Column="3" Title="Departamentos" Value="{Binding DepartmentsCount}" Subtitle="Áreas organizadas" Icon="🏢" AccentColor="{StaticResource Color.Info}" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <controls:MetricCard Grid.Column="0" Title="Cargos cadastrados" Value="{Binding PositionsCount}" Subtitle="Níveis e funções" Icon="📌" AccentColor="{StaticResource Color.Primary}" />
                    <controls:MetricCard Grid.Column="1" Title="Média salarial" Value="{Binding AverageSalaryDisplay}" Subtitle="Base global" Icon="💰" AccentColor="{StaticResource Color.Accent}" />
                </Grid>

                <Border
                    Padding="16"
                    BackgroundColor="{StaticResource Color.CardBackground}"
                    Stroke="{StaticResource Color.BorderSubtle}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Resumo de headcount" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Color.TextPrimary}" />
                        <Label Text="{Binding HeadcountSummary}" FontSize="13" TextColor="{StaticResource Color.TextSecondary}" />
                        <Label Text="{Binding LastUpdatedDisplay}" FontSize="11" TextColor="{StaticResource Color.TextMuted}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
