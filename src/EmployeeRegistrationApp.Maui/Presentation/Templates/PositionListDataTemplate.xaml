<!-- src/EmployeeRegistrationApp.Maui/Presentation/Templates/PositionListDataTemplate.xaml -->
<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtoPositions="clr-namespace:EmployeeRegistrationApp.Application.DTOs.Positions;assembly=EmployeeRegistrationApp.Application">

    <!-- DataTemplate para itens da lista de cargos -->
    <DataTemplate x:Key="PositionListItemTemplate" x:DataType="dtoPositions:PositionDto">
        <Border
            Padding="12"
            Margin="0,4"
            StrokeThickness="1"
            Stroke="#1F2933"
            BackgroundColor="#020617"
            StrokeShape="RoundRectangle 12">
            <Grid
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="4"
                VerticalOptions="Center"
                HorizontalOptions="FillAndExpand">

                <!-- Título do cargo + tipo -->
                <StackLayout Grid.Column="0" Spacing="2">
                    <StackLayout Orientation="Horizontal" Spacing="6">
                        <Label
                            Text="{Binding Title}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#E5E7EB" />

                        <Border
                            Padding="6,2"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 999"
                            BackgroundColor="#111827">
                            <Label
                                Text="{Binding PositionType}"
                                FontSize="11"
                                TextColor="#9CA3AF" />
                        </Border>
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="4">
                        <Label
                            Text="Departamento:"
                            FontSize="11"
                            TextColor="#6B7280" />
                        <Label
                            Text="{Binding DepartmentName}"
                            FontSize="11"
                            TextColor="#D1D5DB" />
                    </StackLayout>
                </StackLayout>

                <!-- Faixa salarial / status -->
                <StackLayout
                    Grid.Column="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Spacing="4">

                    <StackLayout Orientation="Horizontal" Spacing="4">
                        <Label
                            Text="Faixa:"
                            FontSize="11"
                            TextColor="#9CA3AF" />
                        <Label
                            Text="{Binding SalaryRange}"
                            FontSize="11"
                            TextColor="#FBBF24" />
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="4">
                        <Label
                            Text="Vagas ativas:"
                            FontSize="11"
                            TextColor="#6B7280" />
                        <Label
                            Text="{Binding OpenPositions}"
                            FontSize="11"
                            TextColor="#34D399"
                            FontAttributes="Bold" />
                    </StackLayout>
                </StackLayout>

                <!-- Linha inferior: requisitos principais -->
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding KeyRequirements}"
                    FontSize="11"
                    TextColor="#6B7280"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
