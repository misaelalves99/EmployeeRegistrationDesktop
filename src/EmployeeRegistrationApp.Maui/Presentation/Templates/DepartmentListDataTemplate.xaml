<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtoDepartments="clr-namespace:EmployeeRegistrationApp.Application.DTOs.Departments;assembly=EmployeeRegistrationApp.Application">

	<DataTemplate x:Key="DepartmentListItemTemplate" x:DataType="dtoDepartments:DepartmentDto">
		<Border
            Padding="12"
            Margin="0,4"
            StrokeThickness="1"
            Stroke="#1F2933"
            BackgroundColor="#020617"
            StrokeShape="RoundRectangle 12">

			<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
				<VerticalStackLayout Grid.Column="0" Spacing="2">
					<HorizontalStackLayout Spacing="8">
						<Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#E5E7EB" />
						<Label Text="{Binding Code}" FontSize="11" TextColor="#9CA3AF" />
					</HorizontalStackLayout>

					<Label
                        Text="{Binding Description}"
                        FontSize="11"
                        MaxLines="2"
                        LineBreakMode="TailTruncation"
                        TextColor="#6B7280" />
				</VerticalStackLayout>

				<!-- Badge simples de Ativo/Inativo -->
				<Border Grid.Column="1" Padding="8,3" StrokeThickness="0" BackgroundColor="#111827" StrokeShape="RoundRectangle 999">
					<Label Text="{Binding IsActive, StringFormat='Ativo: {0}'}" FontSize="11" TextColor="#D1D5DB" />
				</Border>
			</Grid>

		</Border>
	</DataTemplate>
</ResourceDictionary>
