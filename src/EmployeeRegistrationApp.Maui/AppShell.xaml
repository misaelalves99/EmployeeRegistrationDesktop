<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:dash="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Dashboard.Views"
       xmlns:emp="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Employees.Views"
       xmlns:dep="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Departments.Views"
       xmlns:pos="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Positions.Views"
       xmlns:rep="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Reports.Views"
       xmlns:sets="clr-namespace:EmployeeRegistrationApp.Maui.Presentation.Settings.Views"
       x:Class="EmployeeRegistrationApp.Maui.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}"
       Shell.ForegroundColor="{StaticResource Color.PrimaryLight}"
       Shell.TitleColor="{AppThemeBinding Light={StaticResource Color.TextPrimary.Light}, Dark={StaticResource Color.TextPrimary}}"
       Shell.UnselectedColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}"
       Shell.DisabledColor="{AppThemeBinding Light={StaticResource Color.DisabledText.Light}, Dark={StaticResource Color.DisabledText}}"
       Shell.NavBarHasShadow="False"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Color.SurfaceElevated.Light}, Dark={StaticResource Color.SurfaceElevated}}"
       Shell.TabBarForegroundColor="{StaticResource Color.PrimaryLight}"
       Shell.TabBarTitleColor="{StaticResource Color.PrimaryLight}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}">
<TabBar>

        <!-- Dashboard -->
        <ShellContent
            Title="Dashboard"
            Route="dashboard-tab"
            ContentTemplate="{DataTemplate dash:DashboardPage}" />

        <!-- Funcionários -->
        <Tab
            Title="Funcionários">
            <ShellContent
                Title="Lista"
                Route="employees-list"
                ContentTemplate="{DataTemplate emp:EmployeesListPage}" />
        </Tab>

        <!-- Departamentos -->
        <Tab
            Title="Departamentos">
            <ShellContent
                Title="Departamentos"
                Route="departments-list"
                ContentTemplate="{DataTemplate dep:DepartmentsListPage}" />
        </Tab>

        <!-- Cargos / Posições -->
        <Tab
            Title="Cargos">
            <ShellContent
                Title="Cargos"
                Route="positions-list"
                ContentTemplate="{DataTemplate pos:PositionsListPage}" />
        </Tab>

        <!-- Relatórios -->
        <Tab
            Title="Relatórios">
            <ShellContent
                Title="Visão Geral"
                Route="reports"
                ContentTemplate="{DataTemplate rep:ReportsPage}" />
        </Tab>

        <!-- Configurações -->
        <Tab
            Title="Configurações">
            <ShellContent
                Title="Configurações"
                Route="settings"
                ContentTemplate="{DataTemplate sets:SettingsPage}" />
        </Tab>

    </TabBar>
</Shell>
