<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary x:Class="EmployeeRegistrationApp.Maui.Resources.Styles.Typography" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Tamanhos de fonte -->
    <x:Double x:Key="FontSize.Display">28</x:Double>
    <x:Double x:Key="FontSize.Title">22</x:Double>
    <x:Double x:Key="FontSize.Subtitle">18</x:Double>
    <x:Double x:Key="FontSize.Body">14</x:Double>
    <x:Double x:Key="FontSize.Caption">12</x:Double>

    <!-- Família de fontes (use as que você registrou em MauiProgram/Resources/Fonts) -->
    <x:String x:Key="FontFamily.Primary">OpenSansRegular</x:String>
    <x:String x:Key="FontFamily.SemiBold">OpenSansSemibold</x:String>

    <!-- Estilo padrão para todas as Labels -->
    <Style TargetType="Label" x:Key="BaseLabelStyle">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <!-- Títulos -->
    <Style TargetType="Label" x:Key="DisplayTitleLabel"
           BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
    </Style>

    <Style TargetType="Label" x:Key="PageTitleLabel"
           BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Label" x:Key="PageSubtitleLabel"
           BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Subtitle}" />
        <Setter Property="TextColor" Value="{StaticResource Color.TextSecondary}" />
    </Style>

    <!-- Texto secundário / descrição -->
    <Style TargetType="Label" x:Key="BodySecondaryLabel"
           BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="TextColor" Value="{StaticResource Color.TextSecondary}" />
    </Style>

    <Style TargetType="Label" x:Key="CaptionLabel"
           BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="TextColor" Value="{StaticResource Color.TextMuted}" />
    </Style>

</ResourceDictionary>
