<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary x:Class="EmployeeRegistrationApp.Maui.Resources.Styles.Controls" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
        <ResourceDictionary Source="Spacing.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Botão primário -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Color.Primary}" />
        <Setter Property="TextColor" Value="{StaticResource Color.TextOnPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.SemiBold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Button}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
        <Setter Property="HeightRequest" Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.ControlPadding}" />
        <Setter Property="BorderColor" Value="{StaticResource Color.Primary}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Torna o estilo primário o padrão para todos os botões -->
    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}" />

    <!-- Botão secundário (por key) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Color.PrimaryLight}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Color.BorderStrong.Light}, Dark={StaticResource Color.BorderStrong}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="TertiaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Color.TextSecondary.Light}, Dark={StaticResource Color.TextSecondary}}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="BackgroundColor" Value="{StaticResource Color.Danger}" />
        <Setter Property="TextColor" Value="{StaticResource Color.TextOnPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource Color.Danger}" />
    </Style>

    <Style x:Key="CompactButtonStyle" TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="HeightRequest" Value="{StaticResource Control.Height.Compact}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.CompactButtonPadding}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    </Style>

    <!-- Stage16 theme parity defaults -->
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Color.PageBackground.Light}, Dark={StaticResource Color.PageBackground}}" />
    </Style>

    <Style TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Color.CardBackground.Light}, Dark={StaticResource Color.CardBackground}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Color.BorderSubtle.Light}, Dark={StaticResource Color.BorderSubtle}}" />
    </Style>
    <!-- Entry padrão -->
    <Style TargetType="Entry" x:Key="BaseEntryStyle">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Color.InputPlaceholder.Light}, Dark={StaticResource Color.InputPlaceholder}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="HeightRequest" Value="{StaticResource Control.Height.Standard}" />
        <Setter Property="Margin" Value="{StaticResource Spacing.ControlMargin}" />
    </Style>

    <Style TargetType="Entry" BasedOn="{StaticResource BaseEntryStyle}" />

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Color.InputPlaceholder.Light}, Dark={StaticResource Color.InputPlaceholder}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="HeightRequest" Value="{StaticResource Control.Height.Standard}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource Color.TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Color.InputPlaceholder.Light}, Dark={StaticResource Color.InputPlaceholder}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Color.InputBackground.Light}, Dark={StaticResource Color.InputBackground}}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="HeightRequest" Value="{StaticResource Control.Height.Standard}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Color.Primary}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Color.Primary}" />
    </Style>

    <!-- Frame como card -->
    <Style x:Key="CardFrameStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Color.CardBackground.Light}, Dark={StaticResource Color.CardBackground}}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.CardPadding}" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Color.BorderSubtle.Light}, Dark={StaticResource Color.BorderSubtle}}" />
    </Style>

    <!-- CollectionView padrão (lista de dashboard, listas de funcionários etc.) -->
    <Style TargetType="CollectionView" x:Key="BaseCollectionViewStyle">
        <Setter Property="ItemsLayout">
            <Setter.Value>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="{StaticResource Spacing.StackMedium}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CollectionView"
           BasedOn="{StaticResource BaseCollectionViewStyle}" />

    <!-- Badge de status (usado no StatusBadge control) -->
    <Style x:Key="StatusBadgeLabelStyle" TargetType="Label"
           BasedOn="{StaticResource CaptionLabel}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Color.BadgeBackground.Light}, Dark={StaticResource Color.BadgeBackground}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Color.BadgeText.Light}, Dark={StaticResource Color.BadgeText}}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Shadow

        x:Key="Shadow.Card"

        Brush="{StaticResource Color.Shadow}"

        Opacity="0.28"

        Radius="20"

        Offset="0,8" />


</ResourceDictionary>
