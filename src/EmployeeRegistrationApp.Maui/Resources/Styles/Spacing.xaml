<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary x:Class="EmployeeRegistrationApp.Maui.Resources.Styles.Spacing" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Escala de espaçamento (em device units) -->
    <x:Double x:Key="Spacing.XXS">2</x:Double>
    <x:Double x:Key="Spacing.XS">4</x:Double>
    <x:Double x:Key="Spacing.S">8</x:Double>
    <x:Double x:Key="Spacing.M">12</x:Double>
    <x:Double x:Key="Spacing.L">16</x:Double>
    <x:Double x:Key="Spacing.XL">24</x:Double>
    <x:Double x:Key="Spacing.XXL">32</x:Double>

    <!-- Espessuras padrão para margin/padding -->
    <Thickness x:Key="Spacing.HorizontalPage">24,0</Thickness>
    <Thickness x:Key="Spacing.VerticalPage">0,24</Thickness>

    <Thickness x:Key="Spacing.CardPadding">16</Thickness>
    <Thickness x:Key="Spacing.SectionSpacing">24,24,24,24</Thickness>

    <!-- Espaçamentos verticais comuns (StackLayout / Grid) -->
    <x:Double x:Key="Spacing.StackSmall">8</x:Double>
    <x:Double x:Key="Spacing.StackMedium">12</x:Double>
    <x:Double x:Key="Spacing.StackLarge">20</x:Double>

    <!-- Raio de borda padrão para cards/botões -->
    <x:Double x:Key="Radius.Small">8</x:Double>
    <x:Double x:Key="Radius.Medium">12</x:Double>
    <x:Double x:Key="Radius.Large">18</x:Double>

    <!-- Stage16 desktop sizing / density foundation -->
    <x:Double x:Key="Spacing.XXXL">48</x:Double>

    <Thickness x:Key="Spacing.PagePadding">24</Thickness>
    <Thickness x:Key="Spacing.PagePaddingWide">32</Thickness>
    <Thickness x:Key="Spacing.ControlPadding">16,10</Thickness>
    <Thickness x:Key="Spacing.ControlMargin">0,4</Thickness>
    <Thickness x:Key="Spacing.CompactButtonPadding">14,8</Thickness>
    <Thickness x:Key="Spacing.AuthCardPadding">28</Thickness>
    <Thickness x:Key="Spacing.EmptyStatePadding">24</Thickness>

    <x:Double x:Key="Radius.XLarge">24</x:Double>
    <x:Double x:Key="Radius.Pill">999</x:Double>

    <x:Double x:Key="Control.Height.Compact">36</x:Double>
    <x:Double x:Key="Control.Height.Standard">44</x:Double>
    <x:Double x:Key="Control.Height.Comfortable">48</x:Double>

    <x:Double x:Key="Content.MaxWidth.Desktop">1200</x:Double>
    <x:Double x:Key="Content.MaxWidth.Auth">1024</x:Double>
    <x:Double x:Key="Content.MaxWidth.Form">640</x:Double>

</ResourceDictionary>
