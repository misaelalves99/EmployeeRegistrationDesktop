<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta principal (dark enterprise) -->
    <Color x:Key="Color.Primary">#2563EB</Color>
    <!-- azul principal -->
    <Color x:Key="Color.PrimaryDark">#1D4ED8</Color>
    <Color x:Key="Color.PrimaryLight">#60A5FA</Color>

    <Color x:Key="Color.Secondary">#0EA5E9</Color>
    <!-- azul ciano (destaques) -->
    <Color x:Key="Color.Accent">#F97316</Color>
    <!-- laranja (alertas suaves) -->

    <!-- Estados -->
    <Color x:Key="Color.Success">#22C55E</Color>
    <Color x:Key="Color.Warning">#EAB308</Color>
    <Color x:Key="Color.Danger">#EF4444</Color>
    <Color x:Key="Color.DangerSoft">#1FEF4444</Color>
    <Color x:Key="Color.Info">#38BDF8</Color>

    <!-- Fundo / superfícies -->
    <Color x:Key="Color.PageBackground">#020617</Color>
    <!-- quase preto -->
    <Color x:Key="Color.Surface">#020617</Color>
    <Color x:Key="Color.SurfaceElevated">#020617</Color>
    <Color x:Key="Color.CardBackground">#020617</Color>
    <Color x:Key="Color.BrandSurface">#0C1A33</Color>

    <!-- Bordas e divisores -->
    <Color x:Key="Color.BorderSubtle">#1F2937</Color>
    <Color x:Key="Color.BorderStrong">#374151</Color>
    <Color x:Key="Color.Divider">#1E293B</Color>

    <!-- Texto -->
    <Color x:Key="Color.TextPrimary">#E5E7EB</Color>
    <!-- cinza bem claro -->
    <Color x:Key="Color.TextSecondary">#9CA3AF</Color>
    <Color x:Key="Color.TextMuted">#6B7280</Color>
    <Color x:Key="Color.TextOnPrimary">#FFFFFF</Color>

    <!-- Inputs -->
    <Color x:Key="Color.InputBackground">#020617</Color>
    <Color x:Key="Color.InputBorder">#1F2937</Color>
    <Color x:Key="Color.InputPlaceholder">#6B7280</Color>
    <Color x:Key="Color.InputFocusedBorder">#2563EB</Color>

    <!-- Outros -->
    <Color x:Key="Color.Overlay">#80000000</Color>
    <Color x:Key="Color.BadgeBackground">#1E293B</Color>
    <Color x:Key="Color.BadgeText">#E5E7EB</Color>

</ResourceDictionary>
